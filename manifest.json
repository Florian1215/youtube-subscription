{
  "manifest_version": 2,
  "name": "YouTube Subscriptions Manager",
  "version": "1.1.2",
  "description": "Manage your YouTube subscriptions directly in Firefox and automatically open new videos.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-subscriptions-manager@florian1215",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "64": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtubeContent.js"],
      "run_at": "document_end"
    }
  ]
}
